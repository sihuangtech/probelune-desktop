{
  "name": "probelune-desktop",
  "version": "1.6.0",
  "description": "Probelune desktop diagnostics and self-hosted multi-location monitoring client",
  "homepage": "https://github.com/sihuangtech/probelune-desktop",
  "author": {
    "name": "Snake Konginchrist",
    "email": "developer@skstudio.cn"
  },
  "main": "main.js",
  "scripts": {
    "dev": "vite --debug",
    "build": "vite build",
    "preview": "vite preview",
    "start": "electron .",
    "electron:dev": "concurrently --kill-others \"npm run dev\" \"wait-on --verbose --timeout 60000 http://localhost:3000 && cross-env NODE_ENV=development electron . --trace-warnings\"",
    "electron:build": "npm run build && electron-builder",
    "electron:preview": "cross-env NODE_ENV=production npm run build && electron .",
    "postinstall": "electron-builder install-app-deps",
    "clean": "rimraf dist release",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:win:x64": "npm run build && electron-builder --win --x64",
    "dist:win:ia32": "npm run build && electron-builder --win --ia32",
    "dist:win:arm64": "npm run build && electron-builder --win --arm64",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:mac:x64": "npm run build && electron-builder --mac --x64",
    "dist:mac:arm64": "npm run build && electron-builder --mac --arm64",
    "dist:mac:universal": "npm run build && electron-builder --mac --universal",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:linux:x64": "npm run build && electron-builder --linux --x64",
    "dist:linux:arm64": "npm run build && electron-builder --linux --arm64",
    "dist:unsigned": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false npm run build && electron-builder --publish=never",
    "dist:win:unsigned": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false npm run build && electron-builder --win --publish=never",
    "dist:mac:unsigned": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false npm run build && electron-builder --mac --publish=never",
    "dist:linux:unsigned": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false npm run build && electron-builder --linux --publish=never"
  },
  "private": true,
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "rimraf": "^6.1.3",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "cn.skstudio.multisitetool",
    "productName": "Probelune",
    "icon": "assets/icon",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "package.json",
      "electron-store-wrapper.js",
      "src/**/*"
    ],
    "extraResources": [
      {
        "from": "node_modules/electron-store",
        "to": "node_modules/electron-store"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "electronLanguages": [
        "en",
        "zh-CN"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "allowElevation": true,
      "uninstallDisplayName": "Probelune",
      "deleteAppDataOnUninstall": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Network",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    }
  },
  "allowScripts": {
    "vue-demi": true,
    "fsevents@2.3.3": true,
    "electron-winstaller@5.4.0": true,
    "electron@45.0.0": true
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.21.0",
    "dotenv": "^18.0.9",
    "electron-store": "^12.0.0",
    "element-plus": "^2.14.7",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "license": "GPL-3.0-or-later"
}
